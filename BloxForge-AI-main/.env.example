# ─────────────────────────────────────────────────────────────────────
# BloxForge AI — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file.
# ─────────────────────────────────────────────────────────────────────

# Database (SQLite — local file)
DATABASE_URL=file:./db/custom.db

# NextAuth secret — generate one with: openssl rand -hex 32
NEXTAUTH_SECRET=change-me-to-a-random-64-char-hex-string

# Public URL of your deployed app (used for OAuth redirects)
NEXTAUTH_URL=http://localhost:3000

# ── Admin account (for the seed script) ──
# Run `bun run scripts/seed-admin.ts` after setting these.
ADMIN_EMAIL=samkomedved319@gmail.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Admin
# Comma-separated list of admin emails (auto-promoted on signup)
ADMIN_EMAILS=samkomedved319@gmail.com

# ── Roblox OAuth2 ──
# Register an app at https://create.roblox.com/credentials
# See docs at #docs → Roblox Authentication, or #oauth-setup
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=https://your-domain.com/api/auth/roblox/oauth/callback

# Roblox user IDs to auto-promote to admin on sign-in (comma-separated)
# Find a user's ID at https://www.roblox.com/users/{id}/profile
ADMIN_ROBLOX_IDS=

# ── AI Provider (optional) ──
# NVIDIA NIM API key from https://build.nvidia.com
# If unset, the app uses a built-in demo engine.
NVIDIA_API_KEY=

# ── Stripe (optional — for paid plans) ──
# Get these from https://dashboard.stripe.com/apikeys + https://dashboard.stripe.com/products
# STRIPE_SECRET_KEY=sk_live_... or sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_... (from Stripe Dashboard → Developers → Webhooks)
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_STUDIO_MONTHLY=price_...
# STRIPE_PRICE_STUDIO_ANNUAL=price_...
