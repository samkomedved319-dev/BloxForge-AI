// BloxForge AI — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("New Forge Session")
  model     String    @default("qwen/qwen2.5-coder-32b-instruct")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant" | "system"
  content        String
  model          String?
  tokens         Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Snippet {
  id          String   @id @default(cuid())
  title       String
  language    String   @default("lua")
  code        String
  description String?
  tags        String?
  createdAt   DateTime @default(now())

  @@map("snippets")
}
